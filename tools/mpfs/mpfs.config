# The Kuiper settings of the PolarFire SoC images, which tools/mpfs/build-image.sh
# sets in config (ci/modify_config.sh): riscv64, the boot files of the PolarFire
# SoC instead of the others, the ADI packages from the local package
# repository of the tools, and the desktop with all the ADI tools (Scopy has
# no riscv64 build)
TARGET_ARCHITECTURE=riscv64
CONFIG_RPI_BOOT_FILES=n
CONFIG_ARCH_ZYNQ=n
CONFIG_ARCH_ARRIA10=n
CONFIG_ARCH_CYCLONE5=n
CONFIG_ARCH_ZYNQMP=n
CONFIG_ARCH_VERSAL=n
CONFIG_ARCH_MPFS=y
ADI_LOCAL_REPO=kuiper-build-temp/adi-local-repo
CONFIG_DESKTOP=y
CONFIG_LIBIIO=y
CONFIG_PYADI=y
CONFIG_LIBM2K=y
CONFIG_LIBAD9166_IIO=y
CONFIG_LIBAD9361_IIO=y
CONFIG_IIO_OSCILLOSCOPE=y
CONFIG_IIO_FM_RADIO=y
CONFIG_FRU_TOOLS=y
CONFIG_JESD_EYE_SCAN_GTK=y
CONFIG_COLORIMETER=y
CONFIG_SCOPY=n
CONFIG_GNURADIO=y
CONFIG_GRM2K=y
